{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "__MSG_appShortName__",
  "version": "0.3.0",
  "description": "__MSG_appDescription__",
  "minimum_chrome_version": "138",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "__MSG_appShortName__",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "src/shared/namespace.js",
        "src/shared/protocol.js",
        "src/shared/settings.js",
        "src/shared/languages.js",
        "src/shared/lang.js",
        "src/shared/hash.js",
        "src/shared/glossary.js",
        "src/shared/engine.js",
        "src/content/tags.js",
        "src/content/segmenter.js",
        "src/content/applier.js",
        "src/content/queue.js",
        "src/content/detect.js",
        "src/content/overlay.js",
        "src/content/main.js"
      ],
      "css": [
        "src/content/content.css"
      ]
    }
  ],
  "commands": {
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "__MSG_commandToggle__"
    }
  },
  "default_locale": "en"
}
